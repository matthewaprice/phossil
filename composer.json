{
    "name": "matthewprice/phossil",
    "description": "A small PHP site with routing and components that builds to static HTML.",
    "authors": [
        {
            "name": "Matthew Price",
            "email": "matthew@matthewaprice.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Phossil\\Components\\": "phossil/components/",
            "Phossil\\Enums\\": "phossil/enums/",
            "Phossil\\Services\\": "phossil/services/",
            "Phossil\\Support\\": "phossil/support/",
            "Phossil\\Views\\": "phossil/views/"
        }
    },
    "scripts": {
        "build": "pnpm build && docker compose exec php php phossil/includes/build.php && pnpm format:build",
        "build:zip": [
            "@build",
            "rm -f dist.zip && cd dist && zip -rq ../dist.zip . -x '.*' '*/.*'"
        ]
    }
}
