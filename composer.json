{
    "name": "matthewaprice/phossil",
    "description": "Routing, typed views and components for PHP sites that build to static HTML.",
    "type": "library",
    "keywords": ["static-site", "static-site-generator", "router", "components", "tailwind", "vite"],
    "homepage": "https://phossil.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Price",
            "email": "matthew@matthewaprice.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Phossil\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Components\\": "phossil/components/",
            "App\\Controllers\\": "phossil/controllers/",
            "App\\Data\\": "phossil/data/",
            "App\\Views\\": "phossil/views/",
            "App\\Tests\\": "tests/Site/",
            "Phossil\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "build": "pnpm build && docker compose exec php php phossil/includes/build.php && pnpm format:build",
        "build:zip": [
            "@build",
            "rm -f dist.zip && cd dist && zip -rq ../dist.zip . -x '.*' '*/.*'"
        ],
        "test": "docker compose exec php vendor/bin/phpunit"
    }
}
