<?xml version="1.0" encoding="UTF-8"?>
<!-- Run with `composer test`, which runs PHPUnit in the php container. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Phossil">
            <file>tests/PhossilTest.php</file>
        </testsuite>
        <testsuite name="Components">
            <directory>tests/Components</directory>
        </testsuite>
        <testsuite name="Services">
            <directory>tests/Services</directory>
        </testsuite>
        <!-- The sample site in app/, which uses the package the way a project would. -->
        <testsuite name="Site">
            <directory>tests/Site</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <directory>app/components</directory>
            <directory>app/controllers</directory>
            <directory>app/views</directory>
        </include>
    </source>
</phpunit>
